# ───────────────────────────────────────────────────────────
#  KuQuant Apex Cloud — Environment Variables Template
#  Copy this to .env and fill in your real values.
#  NEVER commit the real .env to GitHub.
# ───────────────────────────────────────────────────────────

# Binance Futures API
BINANCE_API_KEY=YOUR_BINANCE_KEY_HERE
BINANCE_API_SECRET=YOUR_BINANCE_SECRET_HERE
BINANCE_TESTNET=true   # Set to false for live trading

# Groq API (trading bot key — separate from your CRM key)
GROQ_API_KEY=YOUR_GROQ_KEY_HERE
GROQ_MODEL=compound-beta

# Render (set automatically by Render, for self-ping keep-alive)
RENDER_EXTERNAL_URL=https://your-service-name.onrender.com
